diff --git a/apps/arcs-mini/voice_player/voice_player_music.c b/apps/arcs-mini/voice_player/voice_player_music.c
index 570e082f..b5573b5f 100644
--- a/apps/arcs-mini/voice_player/voice_player_music.c
+++ b/apps/arcs-mini/voice_player/voice_player_music.c
@@ -426,3 +426,71 @@ int voice_player_music_init(void)
 
     return ret == 0 ? 0 : -1;
 }
+
+
+/* ==================== UI / 按键用的查询与控制接口 ==================== */
+
+bool voice_player_music_is_active(void)
+{
+    if (music_player == NULL) {
+        return false;
+    }
+    app_player_state_t st = app_player_get_state(music_player);
+    return st == APP_PLAYER_STATE_PLAYING || st == APP_PLAYER_STATE_PAUSED;
+}
+
+bool voice_player_music_is_paused(void)
+{
+    if (music_player == NULL) {
+        return false;
+    }
+    return app_player_get_state(music_player) == APP_PLAYER_STATE_PAUSED;
+}
+
+int voice_player_music_get_progress(uint32_t *pos_ms, uint32_t *dur_ms)
+{
+    uint32_t pos = 0;
+    uint32_t dur = 0;
+    int rp;
+    int rd;
+
+    if (pos_ms) {
+        *pos_ms = 0;
+    }
+    if (dur_ms) {
+        *dur_ms = 0;
+    }
+    if (music_player == NULL) {
+        return -1;
+    }
+
+    rp = app_player_get_position(music_player, &pos);
+    rd = app_player_get_duration(music_player, &dur);
+    if (pos_ms) {
+        *pos_ms = pos;
+    }
+    if (dur_ms) {
+        *dur_ms = dur;
+    }
+    return (rp == 0 && rd == 0) ? 0 : -1;
+}
+
+void voice_player_music_toggle_pause(void)
+{
+    app_player_state_t st;
+
+    if (music_player == NULL) {
+        return;
+    }
+
+    st = app_player_get_state(music_player);
+    if (st == APP_PLAYER_STATE_PLAYING) {
+        voice_intent_music_set_user_paused(true);
+        app_player_pause(music_player);
+        LOGI("[MUSIC] user pause");
+    } else if (st == APP_PLAYER_STATE_PAUSED) {
+        voice_intent_music_set_user_paused(false);
+        app_player_resume(music_player);
+        LOGI("[MUSIC] user resume");
+    }
+}
